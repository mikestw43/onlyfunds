generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// SQLite — single file on the VPS (backend/onlyfunds.db), backed up by
// deploy/backup.sh. Previously Postgres on Railway; every field in this
// schema (String/Int/Float/Boolean/DateTime/Json) is SQLite-compatible.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  password         String? // optional — Google-only users have no password
  googleId         String?              @unique // populated when account is linked to a Google login
  avatarUrl        String? // pulled from Google profile when available
  name             String?
  displayName      String?
  mobile           String?
  phoneCountry     String?
  role             String               @default("user")
  status           String               @default("active") // 'active' | 'pending' | 'rejected' | 'suspended'
  telegramBotToken String?
  telegramChatId   String?
  // Scheduled Reports
  reportEnabled    Boolean              @default(false)
  reportFrequency  String               @default("daily")
  reportTime       String               @default("20:00")
  reportDay        Int                  @default(1)
  // The assistant. Off for everyone but an admin until it is switched on
  // per person: every question is paid for by whoever owns the API key,
  // which is the person running the dashboard, not the one asking.
  aiEnabled        Boolean              @default(false)
  /// Questions a day. 0 means no limit; admins are never limited.
  aiDailyLimit     Int                  @default(30)
  // Preferences
  language         String               @default("en")
  theme            String               @default("dark")
  timezone         String               @default("Asia/Bangkok")
  // Live ticker symbols (JSON array of strings). Null = use server default.
  tickerSymbols    Json?
  passwordResets   PasswordResetToken[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  lastLoginAt      DateTime?
  accounts         Account[]
  accountGroups    AccountGroup[]
  notificationLogs NotificationLog[]
  auditLogs        AuditLog[]
  pushDevices      PushDevice[]
}

model AccountGroup {
  id        String    @id @default(uuid())
  name      String
  color     String    @default("#6b7280")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts  Account[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model Account {
  id                 String           @id @default(uuid())
  name               String
  broker             String
  accountNumber      String
  apiKey             String           @unique
  server             String           @default("Unknown")
  currency           String           @default("USD")
  leverage           Int              @default(100)
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId            String?
  group              AccountGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Alert thresholds (null = disabled)
  alertDrawdown      Float?
  alertEquityBelow   Float?
  alertMarginLevel   Float?
  alertOffline       Boolean          @default(false)
  /// How long the same alert on this account must stay quiet before it
  /// may be sent again, in minutes. Zero means no floor at all.
  ///
  /// A backstop rather than the main defence: what actually stops a
  /// figure hovering on the line from alerting over and over is the
  /// recovery margin in alertService, which only re-arms once it has come
  /// back well clear. This caps the rest.
  alertRepeatMins    Int              @default(30)
  // Demo / sandbox flag
  isDemo             Boolean          @default(false)
  /// Retired. The assistant used to be able to send an order here
  /// without anybody pressing confirm; the confirm step is the point, so
  /// the switch is gone and nothing reads this any more. The column stays
  /// because dropping one needs --accept-data-loss, which the deploy
  /// deliberately does not pass.
  aiAutoTrade        Boolean          @default(false)
  // Drawdown Protection
  protectionEnabled  Boolean          @default(false)
  protectionDrawdown Float?
  // Last snapshot the EA pushed. Persisted so a restarted API shows the
  // figures this account really had, instead of placeholder money — an
  // account whose EA is offline used to come back reading 1,000.
  balance            Float            @default(0)
  equity             Float            @default(0)
  margin             Float            @default(0)
  freeMargin         Float            @default(0)
  marginLevel        Float            @default(0)
  profit             Float            @default(0)
  drawdown           Float            @default(0)
  openLots           Float            @default(0)
  buyLots            Float            @default(0)
  sellLots           Float            @default(0)
  pendingOrders      Int              @default(0)
  todayPnl           Float?
  closedOrdersToday  Int?
  brokerTimeOffset   Int?
  /// Every symbol the broker offers on this account, as the EA last listed
  /// them (JSON array of names). It is what the NEW TRADE box searches. The
  /// reporter only sends it occasionally — a broker's list runs to hundreds
  /// of names and does not change between ticks — so this is the copy that
  /// survives both restarts and the gaps between pushes.
  symbols            Json?
  symbolsAt          DateTime?
  /// What a lot of each symbol in use is worth, straight from the
  /// terminal: contract size, tick value, the volume steps, the live
  /// bid and ask and a 14-day ATR. Sent by EA v1.4 and up. Without
  /// these, anything said about position size is a guess.
  specs              Json?
  specsAt            DateTime?
  /// When that snapshot arrived — null means the EA has never connected.
  lastPushAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  alertStates        AlertState[]
  equitySnapshots    EquitySnapshot[]
  closedTrades       ClosedTrade[]
  dailyPnl           DailyPnl[]

  @@index([userId])
  @@index([apiKey])
  @@index([groupId])
}

/// Where each alert on each account stands, so it survives a restart.
///
/// This used to be a Map in the API's memory. The dashboard redeploys
/// itself every five minutes, and every deploy wiped it — so an account
/// sitting over its threshold started alerting again from scratch, which
/// is the opposite of what the cooldown existed for.
model AlertState {
  id          String    @id @default(uuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// drawdown | equity | margin | offline
  type        String
  /// True while the condition is over the line and has been announced.
  /// Cleared only when it recovers past the margin, which is what stops a
  /// figure wobbling across the threshold from alerting on every wobble.
  firing      Boolean   @default(false)
  /// The reading when it last alerted, so a condition that gets markedly
  /// worse can speak up instead of staying silent behind `firing`.
  lastValue   Float?
  lastFiredAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([accountId, type])
  @@index([accountId])
}

model EquitySnapshot {
  id        String   @id @default(uuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  equity    Float
  balance   Float
  drawdown  Float
  timestamp DateTime @default(now())

  @@index([accountId, timestamp])
  @@index([accountId])
}

model ClosedTrade {
  id              String   @id @default(uuid())
  /// Null once the account is removed from the dashboard. The row stays: the
  /// calendar is the record of what was actually traded, and taking an account
  /// off the screen is not a claim that its trades never happened.
  accountId       String?
  account         Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// Owner and a snapshot of the account, so a detached row can still be
  /// found, labelled and converted to USD without the account to read it from.
  userId          String?
  accountName     String?
  accountCurrency String?
  accountIsDemo   Boolean  @default(false)
  /// The closing deal's own ticket.
  ///
  /// A position closed in parts produces one deal per part, all sharing the
  /// position id. Keying on the position id made the second part overwrite the
  /// first — the earlier day lost its profit and the total came out wrong.
  /// Null on rows written before this, and on the position-diff fallback.
  dealTicket      Int?
  /// "deal" — reported by the EA from the broker's own deal history, exact.
  /// "detected" — guessed from a position that vanished from the open list:
  /// the close time is when the server noticed and the profit is the last
  /// floating figure. Only ever right by accident, so it is marked.
  source          String   @default("deal")
  /// The position id. No longer the key, but still what a trade is called.
  ticket          Int
  symbol          String
  type            String
  lots            Float
  openPrice       Float
  closePrice      Float
  profit          Float
  swap            Float    @default(0)
  commission      Float    @default(0)
  openTime        DateTime
  closeTime       DateTime @default(now())
  sl              Float    @default(0)
  tp              Float    @default(0)

  @@unique([accountId, dealTicket])
  @@index([accountId, closeTime])
  @@index([userId, closeTime])
  @@index([accountId])
}

/// One phone (or desktop browser) that has agreed to receive alerts.
///
/// A person has as many rows here as they have devices, and each is the
/// address the push service gave us for that one browser on that one
/// device — not something we chose, and not something that identifies
/// them anywhere else. The keys are the browser's own; a push is
/// encrypted to them so the push service relaying it cannot read it.
model PushDevice {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The push service's URL for this browser. Unique: a browser that
  /// re-subscribes gets the same endpoint back, and must not pile up rows
  /// that would each deliver the same alert again.
  endpoint  String    @unique
  p256dh    String
  auth      String
  /// What the browser called itself when it subscribed, so the settings
  /// page can say "iPhone" rather than a 300-character URL.
  label     String?
  createdAt DateTime  @default(now())
  /// Last time the push service accepted a message for this device. A
  /// device that has gone quiet for months is almost certainly a browser
  /// that was uninstalled without telling us.
  lastOkAt  DateTime?

  @@index([userId])
}

/// A notice from whoever runs the dashboard to everyone who uses it.
///
/// Not an alert. An alert is about one person's money and is addressed to
/// them; this is addressed to the room — a release note, a maintenance
/// window, a broker holiday. They are kept apart all the way through, down
/// to separate unread counts, so that a note about a new feature can never
/// bury a margin call.
///
/// The page this replaces kept its posts in the browser tab that typed
/// them: three sample notices written at design time, and anything posted
/// was gone on leaving the page.
model Announcement {
  id         String   @id @default(uuid())
  title      String
  body       String
  /// info | warning | update | maintenance — what colour it reads as.
  type       String   @default("info")
  /// Held at the top of the list, above the dated ones.
  pinned     Boolean  @default(false)
  /// Who posted it, kept by name so a deleted admin does not erase the
  /// authorship of a notice everyone has read.
  authorId   String?
  authorName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}

model NotificationLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String?
  type      String
  message   String
  success   Boolean  @default(true)
  sentAt    DateTime @default(now())

  @@index([userId, sentAt])
  @@index([userId])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       String
  resourceType String?
  resourceId   String?
  details      String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

/// A thing in the repository — an EA, an indicator, a script. Its screenshots,
/// presets and older builds hang off it, so a preset is never orphaned from the
/// build it belongs to.
model EaItem {
  id          String   @id @default(uuid())
  name        String
  /// One or more of: MT5 EA | MT4 EA | Indicator | Script | Source | Other,
  /// comma separated. Stored the way tags are — an entry is often two things
  /// at once (an EA and its source), and the single value could not say so.
  /// Rows written before this held exactly one, which parses as a list of one.
  type        String
  /// Untest | Waiting | OK | Other — where this entry stands, at a glance.
  status      String   @default("OK")
  description String   @default("")
  /// Named links, as JSON: [{ "label": "Telegram", "url": "https://…" }].
  /// A list rather than columns because there is no natural number of them —
  /// a vendor page, a download, a manual and a chat group is already four.
  links       String   @default("[]")
  /// Superseded by `links`, which is backfilled from them once at startup.
  /// Kept so that backfill has something to read on an old database.
  url         String   @default("")
  url2        String   @default("")
  /// Flagged by hand as one to keep an eye on. Shown as a red bookmark in
  /// front of the name everywhere the entry is listed.
  important   Boolean  @default(false)
  /// How well it does, 1–5. Zero is not "bad" but "not rated yet": an entry
  /// nobody has run has no score, and must not read as the worst one.
  rating      Int      @default(0)
  /// Who wrote it. Free text — most of these are handles, not companies.
  developer   String   @default("")
  /// Free-form labels, comma separated. A join table buys nothing while the
  /// list is small enough to filter in memory, and costs a migration to add.
  tags        String   @default("")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images EaImage[]
  files  EaFile[]
}

/// Screenshot. `storedName` is the name on disk; the original is kept for
/// display and for the download filename.
model EaImage {
  id         String   @id @default(uuid())
  itemId     String
  item       EaItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  storedName String
  filename   String
  caption    String   @default("")
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([itemId])
}

model EaFile {
  id         String   @id @default(uuid())
  itemId     String
  item       EaItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  storedName String
  filename   String
  /// What this file is: "Current build", "Preset", "Previous build".
  label      String   @default("")
  size       Int
  createdAt  DateTime @default(now())

  @@index([itemId])
}

/// MT5's own realized P/L for one broker day, as the EA reports it.
///
/// The calendar used to be rebuilt by adding up the trades we had stored, so
/// every gap, overwrite or guess in that reconstruction showed up as a day
/// that disagreed with the terminal — and stayed wrong forever, because
/// nothing ever went back to check it. The EA already computes the day's
/// realized total straight from MT5's deal history on every push; this table
/// simply keeps that number instead of throwing it away. The stored trades are
/// still what the list is made of, but they no longer decide the total.
model DailyPnl {
  id              String   @id @default(uuid())
  /// Null once the account is removed. The day stays: the calendar is the
  /// record of what was really traded.
  accountId       String?
  account         Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// Snapshot of the owner, so a detached day is still attributable.
  userId          String?
  accountName     String?
  accountCurrency String?
  accountIsDemo   Boolean  @default(false)
  /// YYYY-MM-DD as the broker's own clock reads it.
  brokerDate      String
  /// Realized profit + swap + commission for that broker day, in the
  /// account's currency, exactly as MT5 totals it.
  netProfit       Float
  /// How many closing deals MT5 counted that day.
  deals           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([accountId, brokerDate])
  @@index([userId, brokerDate])
  @@index([accountId])
}

/// A one-time link for setting a new password.
///
/// The token is stored hashed, like a password, because that is what it is
/// for as long as it lives: anything that can read this table must not be
/// able to take over an account with what it finds. Rows are kept after use
/// rather than deleted, so a link that arrives twice can be told from one
/// that was never issued.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token that went out in the email. The token itself is
  /// never written down anywhere.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Every attempt to send mail, kept so an admin can see what happened without
/// reading the server log. A phone cannot tail a log file; this is the same
/// information in the app. No link or token is ever stored here — only who it
/// was for, what it was, and how it went.
model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  kind      String // 'approval' | 'rejection' | 'reset' | 'google-notice' | 'other'
  status    String // 'sent' | 'failed' | 'skipped' | 'not_configured'
  detail    String? // the provider's id, or the reason it did not go
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Every command sent to an EA and what became of it.
///
/// The dashboard used to say "queued" and stop there — which was the whole
/// truth, since nothing executed them, and will be a lie the moment one
/// does. A command can be refused by the broker, by the EA's own limits, or
/// never picked up at all, and the person who pressed the button is owed
/// that answer.
model CommandLog {
  id        String    @id @default(uuid())
  commandId String    @unique // the id handed to the EA
  accountId String
  userId    String
  type      String // OPEN_TRADE | CLOSE_POSITION | SET_SLTP | CLOSE_ALL
  detail    String? // what was asked, in words
  status    String    @default("queued") // queued | sent | done | failed | dropped
  result    String? // ticket number, or the reason it failed
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  settledAt DateTime?

  @@index([accountId, createdAt])
  @@index([userId, createdAt])
}

/// Settings an admin changes from the dashboard rather than from a shell.
///
/// The AI provider lives here because the alternative is SSH, nano and a
/// restart for something as ordinary as swapping a key — and because the
/// person who owns this dashboard reads it on a phone. Anything secret is
/// stored encrypted, the same way Telegram bot tokens are, and is never
/// sent back to the browser.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// A conversation with the assistant, kept so it is still there tomorrow.
///
/// It used to live in the browser's memory and nowhere else: a refresh, a
/// phone that put the app to sleep, or simply coming back in the morning
/// and yesterday's reading of the portfolio was gone. Chats belong to one
/// person and are never shared — the assistant is looking at their money.
model AiChat {
  id        String      @id @default(uuid())
  userId    String
  /// The first question, shortened — enough to find it again in a list.
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

/// One turn. Photos are deliberately not kept: a few of them would be
/// larger than every other row in this database put together, and their
/// value is in the answer, which is kept. A message that had one says so.
model AiMessage {
  id        String   @id @default(uuid())
  chatId    String
  chat      AiChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      String // 'user' | 'assistant'
  text      String
  photos    Int      @default(0)
  model     String? // which model answered, for an answer
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

/// What the assistant cost, per person per day.
///
/// A limit nobody can see the usage behind is a number picked out of the
/// air. This is the row the daily limit is counted against and the month's
/// total is added up from.
model AiUsage {
  id        String   @id @default(uuid())
  userId    String
  /// YYYY-MM-DD in the server's timezone — a day, not a timestamp.
  day       String
  questions Int      @default(0)
  inTokens  Int      @default(0)
  outTokens Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
  @@index([day])
}

/// Something the assistant should know every time, not just in the
/// conversation where it was said.
///
/// A model does not learn from being talked to: the one answering
/// tomorrow is the same one that answered today, with no memory of it.
/// What can be done is to hand it the same short list of facts with
/// every question — which is what this is. Kept small on purpose: it
/// is read in full on every single question, and a page of notes is a
/// page of notes paid for each time.
model AiMemory {
  id        String   @id @default(uuid())
  userId    String
  text      String
  /// 'you' — typed in by the person. 'ai' — proposed in a conversation
  /// and accepted. Shown so a list nobody recognises can be pruned.
  source    String   @default("you")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
